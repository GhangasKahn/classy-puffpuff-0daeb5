# eBay Developer Program — fill from https://developer.ebay.com/my/keys
# NEVER commit real Cert IDs. Rotate any key that was pasted into chat or screenshots.

# sandbox | production
EBAY_ENV=sandbox

# Sandbox keyset (Application Keys → Sandbox)
EBAY_SBX_APP_ID=your-sandbox-app-id
EBAY_SBX_DEV_ID=your-dev-id
EBAY_SBX_CERT_ID=your-sandbox-cert-id

# Production keyset (Application Keys → Production)
EBAY_PRD_APP_ID=your-production-app-id
EBAY_PRD_DEV_ID=your-dev-id
EBAY_PRD_CERT_ID=your-production-cert-id

# Marketplace (Browse / Insights)
EBAY_MARKETPLACE_ID=EBAY_US

# Server
PORT=8787
HOST=127.0.0.1

# Optional: comma-separated origins for CORS (default allows localhost)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500,http://localhost:8888,null

# --- Sell APIs (listings + orders) — optional for live publish ---
# Browse research works with App token only. Inventory/Fulfillment need a user refresh token.
# Create RuName + consent URL in eBay Developer → get refresh token once.
# EBAY_USER_REFRESH_TOKEN=
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_MERCHANT_LOCATION_KEY=
